# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=5000

# ------------------------------------------------------------------
# MySQL (phpMyAdmin default local setup)
# ------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pern-auth_template-db
MYSQL_USER=root
MYSQL_PASSWORD=root1234
DATABASE_URL=mysql://root:root1234@localhost:3306/pern-auth_template-db

# ------------------------------------------------------------------
# Simple JWT authentication (no session timeout constraints)
# ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ------------------------------------------------------------------
# Cloudinary (certificates / quality-test report uploads)
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=df8fxkmdo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_FOLDER=test-material-warehouse

# ------------------------------------------------------------------
# CORS - allowed frontend origin
# ------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:3000
